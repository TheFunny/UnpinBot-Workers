{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unpinbot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"observability": {
		"enabled": true
	},
	// Paste the id printed by `npx wrangler d1 create unpinbot`.
	// Prefer a custom domain route (exact-match TLS cert): Telegram may reject
	// the wildcard *.workers.dev certificate.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "unpinbot",
			"database_id": "32595f91-017b-4202-83e6-e47c47d13e25"
		}
	]
}